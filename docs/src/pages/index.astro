---
import Layout from '../layouts/Layout.astro'

const introductionUrl = `${import.meta.env.BASE_URL}getting-started/introduction/`
---

<Layout title="UX Driver" description="Documentation for the UX Driver Symfony UX package.">
  <section class="hero">
    <p class="eyebrow">Symfony UX package</p>
    <h1>UX Driver</h1>
    <p>Documentation foundation for building guided product tours with Driver.js.</p>
    <a class="button" href={introductionUrl}>Read the docs</a>
  </section>
</Layout>
