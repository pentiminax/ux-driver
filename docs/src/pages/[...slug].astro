---
import { getCollection, render } from 'astro:content'
import Aside from '../components/Aside.astro'
import Badge from '../components/Badge.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import DocsDrawer from '../components/DocsDrawer.astro'
import DocsNav from '../components/DocsNav.astro'
import Icon from '../components/Icon.astro'
import Pager from '../components/Pager.astro'
import Steps from '../components/Steps.astro'
import TabItem from '../components/TabItem.astro'
import Tabs from '../components/Tabs.astro'
import Toc from '../components/Toc.astro'
import Layout from '../layouts/Layout.astro'
import { getDocsNav, withBase } from '../nav'

export async function getStaticPaths() {
  const entries = await getCollection('docs')

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const nav = await getDocsNav()
const index = nav.findIndex((item) => item.slug === entry.id)
const current = nav[index]
const previous = nav[index - 1]
const next = nav[index + 1]

const editUrl = `https://github.com/pentiminax/ux-driver/edit/main/docs/src/content/docs/${entry.id}.mdx`
---

<Layout title={`${entry.data.title} | UX Driver`} description={entry.data.description}>
  <DocsDrawer
    currentSlug={entry.id}
    currentTitle={entry.data.title}
    sectionTitle={current.section.title}
  />

  <div class="doc-shell">
    <aside class="doc-sidebar">
      <DocsNav currentSlug={entry.id} />
    </aside>

    <article class="doc-article" data-pagefind-body>
      <header class="doc-header">
        <Breadcrumb
          trail={[
            { label: current.section.title, href: withBase(`${current.section.id}/`) },
            { label: entry.data.title },
          ]}
        />
        <h1>{entry.data.title}</h1>
        <p class="doc-lede">{entry.data.description}</p>
      </header>

      <Content components={{ Aside, Badge, Steps, TabItem, Tabs }} />

      <footer class="doc-footer">
        <a class="edit-link" href={editUrl}>
          <Icon name="pencil" size={16} />
          Edit this page on GitHub
        </a>
        <Pager previous={previous} next={next} />
      </footer>
    </article>

    <aside class="doc-toc">
      <Toc headings={headings} />
    </aside>
  </div>
</Layout>
