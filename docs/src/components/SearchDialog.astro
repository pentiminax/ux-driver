---
import Icon from './Icon.astro'
import { sections } from '../nav'

const sectionLabels = Object.fromEntries(sections.map((section) => [section.id, section.title]))
---

<dialog
  class="search-dialog"
  data-search-dialog
  data-section-labels={JSON.stringify(sectionLabels)}
  aria-label="Search documentation"
>
  <div class="search-field">
    <Icon name="search" size={18} class="search-field-icon" />
    <input
      type="search"
      data-search-input
      placeholder="Search the documentation"
      aria-label="Search the documentation"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <button type="button" class="search-close" data-search-close aria-label="Close search">
      <Icon name="close" size={18} />
    </button>
  </div>

  <div class="search-body">
    <ul class="search-results" id="search-results" role="listbox" data-search-results></ul>
    <p class="search-status" data-search-status>Type to search Tours, Hints, options, and events.</p>
  </div>

  <p class="search-hint">
    <kbd>↑</kbd><kbd>↓</kbd> to navigate · <kbd>Enter</kbd> to open · <kbd>Esc</kbd> to close
  </p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')
  const input = document.querySelector<HTMLInputElement>('[data-search-input]')
  const results = document.querySelector<HTMLElement>('[data-search-results]')
  const status = document.querySelector<HTMLElement>('[data-search-status]')
  const closeButton = document.querySelector('[data-search-close]')

  if (dialog && input && results && status) {
    const sectionLabels: Record<string, string> = JSON.parse(dialog.dataset.sectionLabels ?? '{}')
    const baseUrl = document.documentElement.dataset.baseUrl ?? '/'
    // Vite rewrites a static `import()` into a preloaded chunk; Pagefind's bundle
    // only exists after the build, so the specifier has to stay opaque.
    const importPagefind = new Function('path', 'return import(path)')
    let pagefind: any
    let token = 0
    let lastFocused: Element | null = null

    const options = () => [...results.querySelectorAll<HTMLAnchorElement>('.search-result')]

    const setActive = (next: HTMLAnchorElement | null) => {
      options().forEach((option) => option.setAttribute('aria-selected', String(option === next)))
      if (next) {
        input.setAttribute('aria-activedescendant', next.id)
        next.scrollIntoView({ block: 'nearest' })
      } else {
        input.removeAttribute('aria-activedescendant')
      }
    }

    const move = (delta: number) => {
      const all = options()
      if (!all.length) return
      const index = all.findIndex((option) => option.getAttribute('aria-selected') === 'true')
      setActive(all[(index + delta + all.length) % all.length] ?? all[0])
    }

    const open = () => {
      lastFocused = document.activeElement
      dialog.showModal()
      input.select()
    }

    const render = (fragments: any[]) => {
      results.replaceChildren()

      for (const [index, fragment] of fragments.entries()) {
        const item = document.createElement('li')
        const link = document.createElement('a')
        link.className = 'search-result'
        link.id = `search-result-${index}`
        link.setAttribute('role', 'option')
        link.setAttribute('aria-selected', 'false')
        link.href = fragment.url

        const heading = document.createElement('span')
        heading.className = 'search-result-title'
        heading.textContent = fragment.meta?.title || fragment.url

        const sectionId = fragment.url.replace(baseUrl, '').split('/')[0]
        if (sectionLabels[sectionId]) {
          const badge = document.createElement('span')
          badge.className = 'search-result-section'
          badge.textContent = sectionLabels[sectionId]
          heading.append(' ', badge)
        }

        const excerpt = document.createElement('span')
        excerpt.className = 'search-result-excerpt'
        excerpt.textContent = (fragment.excerpt ?? '').replace(/<[^>]+>/g, '')

        link.append(heading, excerpt)
        item.append(link)
        results.append(item)
      }

      input.setAttribute('aria-expanded', String(fragments.length > 0))
      setActive(options()[0] ?? null)
    }

    document.querySelectorAll('[data-search-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', open)
    })

    document.addEventListener('keydown', (event) => {
      const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k'
      const isSlash = event.key === '/' && !dialog.open && !/^(INPUT|TEXTAREA)$/.test((event.target as HTMLElement)?.tagName ?? '')
      if (isShortcut || isSlash) {
        event.preventDefault()
        open()
      }
    })

    closeButton?.addEventListener('click', () => dialog.close())

    // `<dialog>` traps focus but not the pointer: clicks land on the backdrop
    // as clicks on the dialog itself, so compare against its own box.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect()
      const outside =
        event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom
      if (outside) dialog.close()
    })

    dialog.addEventListener('close', () => {
      ;(lastFocused as HTMLElement | null)?.focus?.()
    })

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault()
        move(1)
      } else if (event.key === 'ArrowUp') {
        event.preventDefault()
        move(-1)
      } else if (event.key === 'Enter') {
        const current = options().find((option) => option.getAttribute('aria-selected') === 'true')
        if (current) {
          event.preventDefault()
          window.location.href = current.href
        }
      }
    })

    input.addEventListener('input', async () => {
      const query = input.value.trim()
      const current = ++token

      if (!query) {
        results.replaceChildren()
        input.setAttribute('aria-expanded', 'false')
        status.hidden = false
        status.textContent = 'Type to search Tours, Hints, options, and events.'
        return
      }

      status.hidden = false
      status.textContent = 'Searching…'

      const url = new URL(`${baseUrl}pagefind/pagefind.js`, window.location.origin)
      pagefind ||= await importPagefind(url.href)
      const search = await pagefind.search(query)
      const fragments = await Promise.all(search.results.slice(0, 8).map((result: any) => result.data()))

      if (current !== token) return

      render(fragments)
      status.hidden = fragments.length > 0
      if (!fragments.length) status.textContent = `No page matches “${query}”.`
    })
  }
</script>
